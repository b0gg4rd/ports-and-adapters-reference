### Case 07: Success - Should accept application/json with charset
POST {{host}}/api/v1/payments
Content-Type: application/json; charset=utf-8

{
  "payerReference": "payer-773899273774",
  "payeeReference": "payee-998877665544",
  "paymentAmount": 100.00,
  "paymentSubject": "Test payment",
  "executionDate": "2030-12-31T10:00:00"
}

> {%
client.test("Should return 201", function() {
    client.assert(response.status === 201, "Expected status 201 but got " + response.status);
});
client.test("Should return Cache-Control no-store and Trace-Id", function() {
    client.assert(response.headers.valueOf("Cache-Control") === "no-store", "Expected no-store");
    client.assert(response.headers.valueOf("Trace-Id") !== null, "Expected Trace-Id header");
});
%}

### Case 08: Failure - Should return 415 if the Content-Type is not application/json
POST {{host}}/api/v1/payments
Content-Type: text/plain

{
  "payerReference": "payer-773899273774",
  "payeeReference": "payee-998877665544",
  "paymentAmount": 100.00,
  "paymentSubject": "Test payment",
  "executionDate": "2030-12-31T10:00:00"
}

> {%
client.test("Should return 415", function() {
    client.assert(response.status === 415, "Expected status 415 but got " + response.status);
});
client.test("Should return application/json with a detail", function() {
    client.assert(response.contentType.mimeType === "application/json", "Expected application/json");
    client.assert(typeof response.body.detail === "string" && response.body.detail.length > 0, "Expected a detail");
});
%}

### Case 09: Failure - Should return 413 if the body exceeds the limit
POST {{host}}/api/v1/payments
Content-Type: application/json

< ./payload-too-large.json

> {%
client.test("Should return 413", function() {
    client.assert(response.status === 413, "Expected status 413 but got " + response.status);
});
%}

### Case 10: Failure - Should return 400 when the body is not valid JSON
POST {{host}}/api/v1/payments
Content-Type: application/json

{bad

> {%
client.test("Should return 400", function() {
    client.assert(response.status === 400, "Expected status 400 but got " + response.status);
});
client.test("Should return an error body", function() {
    client.assert(typeof response.body.detail === "string" && response.body.detail.length > 0, "Expected a detail");
});
%}
