### Case 01: Success - Should return 201 when creating a "payment"
POST {{host}}/api/v1/payments
Content-Type: application/json

{
  "payerReference": "payer-773899273774",
  "payeeReference": "payee-998877665544",
  "paymentAmount": 100.00,
  "paymentSubject": "Test payment",
  "executionDate": "2030-12-31T10:00:00"
}

> {%
client.test("Should return 201 with a uuid reference header", function() {
    client.assert(response.status === 201, "Expected status 201 but got " + response.status);
    var reference = response.headers.valueOf("Payment-Reference");
    client.assert(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(reference), "Expected header Payment-Reference to be a uuid, got " + reference);
});
%}

